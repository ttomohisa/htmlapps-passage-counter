{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Passage Counter",
  "nameJa": "通過カウンター",
  "slug": "passage-counter",
  "version": "1.0.0",
  "description": "Count people crossing a line in a camera feed or local video. Processing stays on this device.",
  "descriptionJa": "カメラや端末内の動画で、判定線を横切る人物の通過を方向別に数えます。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-passage-counter"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 10,
      "selfExtractWarningMb": 10
    }
  }
}
