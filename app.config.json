{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Passage Counter",
  "nameJa": "通過カウンター",
  "slug": "passage-counter",
  "version": "0.2.0",
  "description": "Count people crossing a line using a fixed camera. Processing stays on this device.",
  "descriptionJa": "カメラを固定し、判定線を横切る人物の通過を数えます。映像は端末内で処理します。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-passage-counter"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 50,
      "selfExtractWarningMb": 32
    }
  }
}
